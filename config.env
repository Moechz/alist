# ============================================================
# AList TOS 7 应用中心 deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# AList 上游版本（GitHub tag，不带 v 前缀）
# 主仓库: https://github.com/AlistGo/alist
ALIST_VERSION=3.64.0

# 封装迭代号（我们自己的发布序号）
# 完整版本 = 上游版本-迭代号，例如 3.64.0-1
# 三处必须一致：config.ini / DEBIAN/control / alist.lang；
# 每次提交商店严格递增；Release tag = v<完整版本>（如 v3.64.0-1）
# ⚠️ 迭代号永远不要零填充：dpkg 认为 -01 == -1
PKG_RELEASE=2

# 目标架构（TOS NAS 的 CPU 架构）:
#   amd64 - Intel/AMD x86_64（绝大多数 TerraMaster NAS）
#   arm64 - ARM64/aarch64 机型
# 可被环境变量覆盖（make arm64 即用）
TARGET_ARCH=${TARGET_ARCH:-amd64}

# TOS 应用 id（/usr/local/<appid>/ 目录、config.ini 的 id/system_id、
# lang 文件名、图标文件名必须全部一致；上架后不可变更）
# 规则：小写字母/数字/连字符，字母开头，≤50 字符
APP_ID=alist

# 运行用户（规范要求专用非 root 用户，preinst 创建；
# config.ini.user 与 systemd User 必须一致）
APP_USER=alist

# 回环监听端口（官方推荐 8000-19999 段；15244 = AList 默认端口
# 5244 的易记变体，且在推荐段内）
APP_PORT=15244

# 二进制源（V6 审核要求源码可审计）：本仓库 CI（.github/workflows/
# build-upstream.yml）从上游 tag 源码构建静态 musl 双架构产物，
# 发布于 Release build-v<上游版本>；此处 pin 自建 tarball 的 sha256，
# CI 重新构建后必须同步更新
SHA256_TARBALL_AMD64=PENDING_CI_RUN_35311557614
SHA256_TARBALL_ARM64=PENDING_CI_RUN_35311557614

# deb 维护者信息（DEBIAN/control 的 Maintainer 与 config.ini 的 publisher）
# 维护者（deb control 的 Maintainer：包出问题找谁 —— 打包者本人）
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"

# 应用中心展示的「开发者」署名 —— 上游原始开发者（勿填打包者）
PUBLISHER="AList Team"
