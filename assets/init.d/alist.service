[Unit]
Description=AList File Manager (multi-storage aggregation & WebDAV)
Documentation=https://alistgo.com/guide/
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=alist
Group=alist
WorkingDirectory=/usr/local/alist
EnvironmentFile=-/usr/local/alist/alist.env
# ExecStart 参数全部写死，绝无 $ 变量展开（systemd 只支持基本 ${VAR}，
# 不支持 shell 风格默认值，曾致全环境 502）。
# AList 没有 CLI 层面的监听地址/端口参数（仅配置文件 + 环境变量），
# 监听安全由两层兜底保证（删除任一层都不会端口外泄）：
#   1) EnvironmentFile 中的活动默认值 ALIST_ADDR=127.0.0.1 等（随包预置）
#   2) postinst 首装预置的 /var/lib/alist/config.json（同样写死回环+端口）
# 优先级：环境变量 > config.json，用户改端口/地址编辑 alist.env 即可。
ExecStart=/usr/local/alist/bin/alist server --data /var/lib/alist
TimeoutStartSec=30
TimeoutStopSec=10
# 注意：按 TOS 规范不配置 Restart/RestartSec——生命周期由应用中心统一管理
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alist
LimitNOFILE=65536
UMask=0027
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

[Install]
WantedBy=multi-user.target
