[en-us]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList is a self-hosted file list program that aggregates many storage backends — local folders, WebDAV, S3-compatible storage and dozens of cloud drives — behind one clean web UI. Browse, preview, upload, download, share links, offline downloads and a built-in WebDAV server let you mount all your storages as a single drive. The app opens in a new browser tab from the TOS desktop. The backend listens on loopback only: no extra port is exposed, all traffic goes through the TOS web server route. Runs as a dedicated unprivileged user in a hardened systemd sandbox. First login: username 'admin'; the initial password is generated at install time and stored root-readable in /var/lib/alist/admin_password.txt."
release_note = "Built from the official AList 3.64.0 source code (static Go build, zero runtime dependencies, frontend embedded; public CI audit trail). The initial admin password is generated at install time and stored root-readable in /var/lib/alist/admin_password.txt (username: admin). Database, config and search index live in /var/lib/alist. WebDAV endpoint: http://<NAS-IP>:8181/alist/dav/. Tune ports, database and optional FTP/SFTP/S3 services in /usr/local/alist/alist.env, then restart the service."
important    = "Initial login username: admin. The initial admin password is only stored in /var/lib/alist/admin_password.txt (readable by the NAS administrator account); read it right after installing, log in as 'admin' and change it in the web UI. 'apt remove' keeps all data in /var/lib/alist; 'apt purge' deletes everything including the password file. Licensed AGPL-3.0 upstream."

[zh-cn]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList 是一款自托管的多网盘聚合文件列表程序，把本地目录、WebDAV、S3 兼容存储以及数十种网盘聚合到同一个清爽的网页界面：浏览、预览、上传下载、分享链接、离线下载，并内置 WebDAV 服务，可以把所有存储挂载成一个盘。应用从 TOS 桌面以新标签页方式打开；后端仅监听本机回环、不对外多开任何端口，全部流量经 TOS 网页服务的标准路由转发，安全省心。服务以专用非特权用户运行并施加 systemd 沙箱加固。首次登录：用户名 admin；初始密码在安装时自动生成，保存在 /var/lib/alist/admin_password.txt（NAS 管理员账户可读）。"
release_note = "基于上游 AList 3.64.0 源码构建（Go 静态编译，零运行时依赖，前端已内嵌；源码与构建流程公开可审计）。初始管理员密码在安装时自动生成，仅存放于 /var/lib/alist/admin_password.txt（NAS 管理员账户可读），账号为 admin。数据库、配置与搜索索引保存在 /var/lib/alist。WebDAV 地址：http://<NAS的IP>:8181/alist/dav/。端口、数据库及可选 FTP/SFTP/S3 服务可在 /usr/local/alist/alist.env 中调整后重启服务。"
important    = "初始登录用户名：admin。初始管理员密码只保存在 /var/lib/alist/admin_password.txt（仅 NAS 管理员账户可读）：安装后立即读取，以用户名 admin 登录网页后台并尽快修改密码。apt remove 卸载时保留 /var/lib/alist 全部数据；apt purge 会彻底删除（含密码文件）。上游采用 AGPL-3.0 许可证。"

[zh-hk]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList 是一款自架設的多網盤聚合檔案清單程式，把本機目錄、WebDAV、S3 相容儲存以及數十種網盤聚合到同一個清爽的網頁介面：瀏覽、預覽、上傳下載、分享連結、離線下載，並內建 WebDAV 服務，可以把所有儲存掛載成一個磁碟區。應用從 TOS 桌面以新分頁方式開啟；後端僅監聽本機回環、不對外多開任何連接埠，全部流量經 TOS 網頁服務的標準路由轉發，安全省心。服務以專用非特權使用者執行並施加 systemd 沙箱強化。首次登入：使用者名稱 admin；初始密碼於安裝時自動產生，儲存於 /var/lib/alist/admin_password.txt（NAS 管理員帳戶可讀）。"
release_note = "基於上游 AList 3.64.0 原始碼構建（Go 靜態編譯，零執行時相依，前端已內嵌；原始碼與構建流程公開可稽核）。初始管理員密碼於安裝時自動產生，僅存放於 /var/lib/alist/admin_password.txt（NAS 管理員帳戶可讀），帳號為 admin。資料庫、設定與搜尋索引保存在 /var/lib/alist。WebDAV 位址：http://<NAS的IP>:8181/alist/dav/。連接埠、資料庫及可選 FTP/SFTP/S3 服務可在 /usr/local/alist/alist.env 中調整後重新啟動服務。"
important    = "初始登入使用者名稱：admin。初始管理員密碼只保存在 /var/lib/alist/admin_password.txt（僅 NAS 管理員帳戶可讀）：安裝後立即讀取，以使用者名稱 admin 登入網頁後台並儘快修改密碼。apt remove 移除時保留 /var/lib/alist 全部資料；apt purge 會徹底刪除（含密碼檔案）。上游採用 AGPL-3.0 授權條款。"

[fr-fr]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList est un programme auto-hébergé de listage de fichiers qui agrège de nombreux espaces de stockage — dossiers locaux, WebDAV, stockage compatible S3 et des dizaines de cloud drives — derrière une interface web épurée : parcours, aperçu, téléversement, téléchargement, liens de partage, téléchargement hors ligne, et un serveur WebDAV intégré pour monter tous vos stockages en un seul lecteur. L'application s'ouvre dans un nouvel onglet depuis le bureau TOS. Le backend n'écoute que sur loopback : aucun port supplémentaire n'est exposé, tout le trafic passe par la route standard du serveur web TOS. S'exécute sous un utilisateur dédié non privilégié dans un bac à sable systemd renforcé. Première connexion : identifiant « admin » ; le mot de passe initial est généré à l'installation et stocké dans /var/lib/alist/admin_password.txt (lisible par le compte administrateur du NAS)."
release_note = "Compilé depuis le code source officiel d'AList 3.64.0 (compilation Go statique, zéro dépendance, frontend intégré ; chaîne d'audit CI publique). Le mot de passe administrateur initial est généré à l'installation et stocké dans /var/lib/alist/admin_password.txt (lisible par le compte administrateur du NAS ; utilisateur : admin). Base de données, configuration et index de recherche sont dans /var/lib/alist. Point d'accès WebDAV : http://<IP-NAS>:8181/alist/dav/. Ports, base de données et services optionnels FTP/SFTP/S3 se règlent dans /usr/local/alist/alist.env puis un redémarrage du service."
important    = "Identifiant de connexion initial : admin. Le mot de passe administrateur initial n'est stocké que dans /var/lib/alist/admin_password.txt : lisez-le juste après l'installation, connectez-vous avec « admin » et changez-le dans l'interface web. « apt remove » conserve les données de /var/lib/alist ; « apt purge » supprime tout (y compris le fichier de mot de passe). Licence AGPL-3.0 en amont."

[de-de]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList ist ein selbst gehostetes Dateilisten-Programm, das zahlreiche Speicherbackends — lokale Ordner, WebDAV, S3-kompatible Speicher und Dutzende Cloud-Laufwerke — hinter einer aufgeräumten Weboberfläche bündelt: Durchsuchen, Vorschau, Hoch- und Herunterladen, Freigabelinks, Offline-Downloads sowie ein integrierter WebDAV-Server, mit dem Sie alle Speicher als ein einziges Laufwerk einbinden können. Öffnet sich über das TOS-Desktop-Symbol in einem neuen Browser-Tab. Das Backend lauscht nur auf Loopback: kein zusätzlicher offener Port, der gesamte Datenverkehr läuft über die Standardroute des TOS-Webservers. Läuft als dedizierter unprivilegierter Benutzer in einer gehärteten systemd-Sandbox. Erste Anmeldung: Benutzername „admin“; das anfängliche Passwort wird bei der Installation erzeugt und liegt in /var/lib/alist/admin_password.txt (lesbar durch das NAS-Administratorkonto)."
release_note = "Aus dem offiziellen AList-3.64.0-Quellcode gebaut (statisch kompiliertes Go, keine Laufzeitabhängigkeiten, Frontend eingebettet; öffentliche CI-Audit-Spur). Das anfängliche Admin-Passwort wird bei der Installation erzeugt und liegt in /var/lib/alist/admin_password.txt (lesbar durch das NAS-Administratorkonto; Benutzername: admin). Datenbank, Konfiguration und Suchindex liegen in /var/lib/alist. WebDAV-Endpunkt: http://<NAS-IP>:8181/alist/dav/. Ports, Datenbank und optionale FTP/SFTP/S3-Dienste stellen Sie in /usr/local/alist/alist.env ein, danach Dienst neu starten."
important    = "Anfänglicher Benutzername: admin. Das anfängliche Admin-Passwort liegt ausschließlich in /var/lib/alist/admin_password.txt: Lesen Sie es direkt nach der Installation, melden Sie sich als „admin“ an und ändern Sie es in der Weboberfläche. „apt remove“ behält die Daten in /var/lib/alist; „apt purge“ löscht alles (inklusive der Passwortdatei). Upstream-Lizenz: AGPL-3.0."

[it-it]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList è un programma self-hosted di elenco file che aggrega molti storage backend — cartelle locali, WebDAV, storage compatibili S3 e decine di cloud drive — dietro un'interfaccia web pulita: sfoglia, anteprima, caricamento, download, link di condivisione, download offline e un server WebDAV integrato per montare tutti gli storage come un unico disco. L'app si apre in una nuova scheda del browser dal desktop TOS. Il backend resta in ascolto solo su loopback: nessuna porta aggiuntiva esposta, tutto il traffico passa dalla route standard del server web TOS. Esegue con un utente dedicato non privilegiato in un sandbox systemd rafforzato. Primo accesso: nome utente «admin»; la password iniziale viene generata all'installazione e salvata in /var/lib/alist/admin_password.txt (leggibile dall'account amministratore del NAS)."
release_note = "Compilato dal codice sorgente ufficiale di AList 3.64.0 (build Go statica, zero dipendenze, frontend incorporato; audit trail CI pubblico). La password amministratore iniziale viene generata all'installazione e salvata in /var/lib/alist/admin_password.txt (leggibile dall'account amministratore del NAS; utente: admin). Database, configurazione e indice di ricerca sono in /var/lib/alist. Endpoint WebDAV: http://<IP-NAS>:8181/alist/dav/. Porte, database e servizi opzionali FTP/SFTP/S3 si regolano in /usr/local/alist/alist.env, quindi riavviare il servizio."
important    = "Nome utente iniziale: admin. La password amministratore iniziale è salvata solo in /var/lib/alist/admin_password.txt: leggila subito dopo l'installazione, accedi con «admin» e cambiala nell'interfaccia web. 'apt remove' conserva i dati in /var/lib/alist; 'apt purge' elimina tutto (incluso il file della password). Licenza upstream AGPL-3.0."

[es-es]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList es un programa autoalojado de listado de archivos que agrega muchos almacenamientos backend — carpetas locales, WebDAV, almacenamientos compatibles S3 y decenas de nubes — detrás de una interfaz web limpia: explorar, previsualizar, subir, descargar, enlaces para compartir, descargas sin conexión y un servidor WebDAV integrado para montar todos tus almacenamientos como una sola unidad. La aplicación se abre en una pestaña nueva del navegador desde el escritorio TOS. El backend escucha solo en loopback: no se expone ningún puerto adicional, todo el tráfico pasa por la ruta estándar del servidor web TOS. Se ejecuta con un usuario dedicado sin privilegios en un sandbox systemd reforzado. Primer inicio de sesión: usuario «admin»; la contraseña inicial se genera al instalar y se guarda en /var/lib/alist/admin_password.txt (puede leerla la cuenta de administrador del NAS)."
release_note = "Compilado a partir del código fuente oficial de AList 3.64.0 (compilación Go estática, cero dependencias, frontend incrustado; auditoría CI pública). La contraseña inicial de administrador se genera al instalar y se guarda en /var/lib/alist/admin_password.txt (legible por la cuenta de administrador del NAS; usuario: admin). Base de datos, configuración e índice de búsqueda están en /var/lib/alist. Endpoint WebDAV: http://<IP-NAS>:8181/alist/dav/. Puertos, base de datos y servicios opcionales FTP/SFTP/S3 se ajustan en /usr/local/alist/alist.env y luego se reinicia el servicio."
important    = "Usuario de inicio de sesión inicial: admin. La contraseña inicial de administrador solo se guarda en /var/lib/alist/admin_password.txt: léela justo después de instalar, inicia sesión con «admin» y cámbiala en la interfaz web. 'apt remove' conserva los datos en /var/lib/alist; 'apt purge' elimina todo (incluido el archivo de contraseña). Licencia upstream AGPL-3.0."

[hu-hu]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList egy önállóan üzemeltetett fájllista-program, amely számos háttértárat von össze — helyi mappák, WebDAV, S3-kompatibilis tárolók és több tucat felhőmeghajtó — egy letisztult webes felület mögé: tallózás, előnézet, feltöltés, letöltés, megosztási linkek, offline letöltés, valamint beépített WebDAV-kiszolgáló, amellyel minden tároló egyetlen meghajtóként csatolható. Az alkalmazás új böngészőlapban nyílik meg a TOS asztalról. A háttérfolyamat csak loopback-en figyel: nincs további nyitott port, minden forgalom a TOS webszerver szabványos útvonalán halad át. Dedikált, nem privilegizált felhasználóként fut, megerősített systemd sandboxban. Első bejelentkezés: felhasználónév „admin”; a kezdeti jelszó telepítéskor jön létre, és a /var/lib/alist/admin_password.txt fájlban tárolódik (a NAS rendszergazdai fiókja olvashatja)."
release_note = "A hivatalos AList 3.64.0 forráskódból építve (statikus Go build, nulla futásidejű függőség, beágyazott frontend; nyilvános CI auditlánc). A kezdeti adminisztrátori jelszó telepítéskor jön létre, és a /var/lib/alist/admin_password.txt fájlban tárolódik (a NAS rendszergazdai fiókja olvashatja; felhasználónév: admin). Az adatbázis, a konfiguráció és a keresési index a /var/lib/alist könyvtárban van. WebDAV végpont: http://<NAS-IP>:8181/alist/dav/. Portok, adatbázis és az opcionális FTP/SFTP/S3 szolgáltatások a /usr/local/alist/alist.env fájlban állíthatók, majd a szolgáltatás újraindítása."
important    = "Kezdeti bejelentkezési felhasználónév: admin. A kezdeti adminisztrátori jelszó kizárólag a /var/lib/alist/admin_password.txt fájlban tárolódik: olvassa el közvetlenül a telepítés után, jelentkezzen be „admin” néven, és változtassa meg a webes felületen. Az 'apt remove' megőrzi a /var/lib/alist adatait; az 'apt purge' mindent töröl (a jelszófájlt is). Felsőbb rétegbeli licenc: AGPL-3.0."

[ja-jp]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList は自己ホストのファイルリストプログラムで、ローカルフォルダー・WebDAV・S3 互換ストレージ・数十種のクラウドドライブを一つの洗練された Web UI に集約します。閲覧・プレビュー・アップロード・ダウンロード・共有リンク・オフラインダウンロードに加え、内蔵 WebDAV サーバーで全ストレージを一つのドライブとしてマウントできます。アプリは TOS デスクトップから新しいタブで開きます。バックエンドはループバックのみで待ち受け、追加のポートは一切公開せず、すべての通信は TOS ウェブサーバーの標準ルートを経由します。専用の非特権ユーザーとして、強化された systemd サンドボックス内で動作します。初回ログイン：ユーザー名は admin。初期パスワードはインストール時に自動生成され、/var/lib/alist/admin_password.txt に保存されます（NAS 管理者アカウントが読み取り可能）。"
release_note = "公式 AList 3.64.0 ソースコードからビルド（静的 Go ビルド、ランタイム依存ゼロ、フロントエンド内蔵。公開 CI による監査証跡付き）。初期管理者パスワードはインストール時に自動生成され、/var/lib/alist/admin_password.txt に保存されます（NAS 管理者アカウントが読み取り可能。ユーザー名: admin）。データベース・設定・検索インデックスは /var/lib/alist に保存。WebDAV エンドポイント: http://<NASのIP>:8181/alist/dav/。ポート・データベース・オプションの FTP/SFTP/S3 サービスは /usr/local/alist/alist.env で調整後、サービスを再起動してください。"
important    = "初期ログインユーザー名: admin。初期管理者パスワードは /var/lib/alist/admin_password.txt のみに保存されます。インストール直後に読み取り、ユーザー名 admin でログインして Web UI 内で変更してください。'apt remove' は /var/lib/alist のデータを保持し、'apt purge' はすべて削除します（パスワードファイル含む）。上流ライセンスは AGPL-3.0 です。"

[ko-kr]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList는 로컬 폴더, WebDAV, S3 호환 스토리지, 수십 종의 클라우드 드라이브를 하나의 깔끔한 웹 UI 뒤에 통합하는 자체 호스팅 파일 목록 프로그램입니다. 탐색, 미리보기, 업로드·다운로드, 공유 링크, 오프라인 다운로드는 물론 내장 WebDAV 서버로 모든 스토리지를 단일 드라이브처럼 마운트할 수 있습니다. TOS 데스크톱에서 새 브라우저 탭으로 열립니다. 백엔드는 루프백만 수신하며 추가 포트를 노출하지 않고, 모든 트래픽은 TOS 웹 서버의 표준 경로를 통과합니다. 전용 비권한 사용자로 실행되며 강화된 systemd 샌드박스로 보호됩니다. 첫 로그인: 사용자 이름은 admin 이며, 초기 비밀번호는 설치 시 자동 생성되어 /var/lib/alist/admin_password.txt 에 저장됩니다(NAS 관리자 계정이 읽기 가능)."
release_note = "공식 AList 3.64.0 소스 코드로부터 빌드(정적 Go 빌드, 런타임 의존성 없음, 프런트엔드 내장, 공개 CI 감사 흔적). 초기 관리자 비밀번호는 설치 시 자동 생성되어 /var/lib/alist/admin_password.txt 에 저장됩니다(NAS 관리자 계정이 읽기 가능, 사용자명: admin). 데이터베이스·설정·검색 인덱스는 /var/lib/alist 에 보관됩니다. WebDAV 엔드포인트: http://<NAS-IP>:8181/alist/dav/. 포트, 데이터베이스, 선택적 FTP/SFTP/S3 서비스는 /usr/local/alist/alist.env 에서 조정한 뒤 서비스를 재시작하세요."
important    = "초기 로그인 사용자 이름: admin. 초기 관리자 비밀번호는 /var/lib/alist/admin_password.txt 에만 저장됩니다. 설치 직후 읽고 사용자 이름 admin 으로 로그인하여 웹 UI 에서 변경하세요. 'apt remove' 는 /var/lib/alist 데이터를 유지하고, 'apt purge' 는 모두 삭제합니다(비밀번호 파일 포함). 업스트림 라이선스는 AGPL-3.0 입니다."

[pl-pl]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList to samodzielnie hostowany program do listowania plików, który agreguje wiele magazynów — lokalne foldery, WebDAV, magazyny zgodne z S3 i dziesiątki dysków chmurowych — za jednym przejrzystym interfejsem webowym: przeglądanie, podgląd, wysyłanie, pobieranie, linki do udostępniania, pobieranie offline oraz wbudowany serwer WebDAV pozwalają zamontować wszystkie magazyny jako jeden dysk. Aplikacja otwiera się w nowej karcie przeglądarki z pulpitu TOS. Backend nasłuchuje tylko na loopback: żaden dodatkowy port nie jest otwarty, cały ruch przechodzi przez standardową trasę serwera WWW TOS. Działa jako dedykowany użytkownik bez uprawnień w wzmocnionej piaskownicy systemd. Pierwsze logowanie: nazwa użytkownika „admin”; hasło początkowe jest generowane podczas instalacji i zapisywane w /var/lib/alist/admin_password.txt (do odczytu przez konto administratora NAS)."
release_note = "Zbudowany z oficjalnego kodu źródłowego AList 3.64.0 (statyczna kompilacja Go, zero zależności środowiskowych, wbudowany frontend; publiczny ślad audytu CI). Początkowe hasło administratora jest generowane podczas instalacji i zapisywane w /var/lib/alist/admin_password.txt (do odczytu przez konto administratora NAS; użytkownik: admin). Baza danych, konfiguracja i indeks wyszukiwania znajdują się w /var/lib/alist. Punkt końcowy WebDAV: http://<IP-NAS>:8181/alist/dav/. Porty, bazę danych i opcjonalne usługi FTP/SFTP/S3 reguluje się w /usr/local/alist/alist.env, po czym restartuje usługę."
important    = "Początkowa nazwa użytkownika: admin. Początkowe hasło administratora jest przechowywane wyłącznie w /var/lib/alist/admin_password.txt: odczytaj je tuż po instalacji, zaloguj się jako „admin” i zmień w interfejsie webowym. 'apt remove' zachowuje dane w /var/lib/alist; 'apt purge' usuwa wszystko (łącznie z plikiem hasła). Licencja nadrzędna: AGPL-3.0."

[ru-ru]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList — самостоятельно размещаемая программа-файловый менеджер, объединяющая множество хранилищ — локальные папки, WebDAV, S3-совместимые хранилища и десятки облачных дисков — за одним аккуратным веб-интерфейсом: просмотр, предпросмотр, загрузка и скачивание, ссылки-приглашения, офлайн-загрузка и встроенный WebDAV-сервер, позволяющий смонтировать все хранилища как один диск. Приложение открывается в новой вкладке браузера с рабочего стола TOS. Бэкенд слушает только loopback: ни одного лишнего открытого порта, весь трафик идёт через стандартный маршрут веб-сервера TOS. Работает от выделенного непривилегированного пользователя в усиленной песочнице systemd. Первый вход: логин «admin»; начальный пароль генерируется при установке и хранится в /var/lib/alist/admin_password.txt (доступен учётной записи администратора NAS)."
release_note = "Собран из официального исходного кода AList 3.64.0 (статическая сборка Go, ноль зависимостей времени выполнения, встроенный фронтенд; публичный CI-аудит). Начальный пароль администратора генерируется при установке и хранится в /var/lib/alist/admin_password.txt (доступен учётной записи администратора NAS; логин: admin). База данных, конфигурация и поисковый индекс находятся в /var/lib/alist. WebDAV-эндпоинт: http://<IP-NAS>:8181/alist/dav/. Порты, база данных и опциональные службы FTP/SFTP/S3 настраиваются в /usr/local/alist/alist.env с последующим перезапуском службы."
important    = "Начальный логин: admin. Начальный пароль администратора хранится только в /var/lib/alist/admin_password.txt: прочитайте его сразу после установки, войдите под логином «admin» и смените в веб-интерфейсе. 'apt remove' сохраняет данные в /var/lib/alist; 'apt purge' удаляет всё (включая файл с паролем). Лицензия upstream: AGPL-3.0."

[tr-tr]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "AList; yerel klasörleri, WebDAV'ı, S3 uyumlu depoları ve düzinelerce bulut diskini tek bir temiz web arayüzünün arkasında birleştiren, kendi sunucunuzda barındırılan bir dosya listeleme programıdır: göz atma, önizleme, yükleme, indirme, paylaşım bağlantıları, çevrimdışı indirme ve tüm depolarınızı tek bir sürücü olarak bağlamanızı sağlayan yerleşik WebDAV sunucusu. Uygulama TOS masaüstünden yeni bir tarayıcı sekmesinde açılır. Arka uç yalnızca loopback dinler: ek bir port açılmaz, tüm trafik TOS web sunucusunun standart yolundan geçer. Ayrıcalıksız özel bir kullanıcı olarak sertleştirilmiş systemd korumalı alanında çalışır. İlk oturum: kullanıcı adı «admin»; başlangıç parolası kurulumda oluşturulur ve /var/lib/alist/admin_password.txt dosyasında saklanır (NAS yönetici hesabı okuyabilir)."
release_note = "Resmî AList 3.64.0 kaynak kodundan derlenmiştir (statik Go derlemesi, sıfır çalışma zamanı bağımlılığı, gömülü arayüz; herkese açık CI denet izi). Başlangıç yönetici parolası kurulum sırasında oluşturulur ve /var/lib/alist/admin_password.txt dosyasında saklanır (NAS yönetici hesabı okuyabilir; kullanıcı adı: admin). Veritabanı, yapılandırma ve arama dizini /var/lib/alist içindedir. WebDAV uç noktası: http://<NAS-IP>:8181/alist/dav/. Portlar, veritabanı ve isteğe bağlı FTP/SFTP/S3 hizmetleri /usr/local/alist/alist.env içinde ayarlanıp hizmet yeniden başlatılarak yapılandırılır."
important    = "Başlangıç oturum kullanıcı adı: admin. Başlangıç yönetici parolası yalnızca /var/lib/alist/admin_password.txt dosyasında saklanır: kurulumdan hemen sonra okuyun, «admin» kullanıcı adıyla oturum açın ve web arayüzünden değiştirin. 'apt remove' /var/lib/alist verilerini korur; 'apt purge' her şeyi siler (parola dosyası dahil). Upstream lisansı: AGPL-3.0."

[pt-pt]
name         = "AList File Manager"
auth         = "AList Team"
version      = "@@VERSION@@"
descript     = "O AList é um programa auto-hospedado de listagem de ficheiros que agrega muitos backends de armazenamento — pastas locais, WebDAV, armazenamentos compatíveis com S3 e dezenas de drives na nuvem — atrás de uma interface web limpa: navegar, pré-visualizar, carregar, descarregar, links de partilha, transferências offline e um servidor WebDAV integrado para montar todos os seus armazenamentos como uma única unidade. A aplicação abre num novo separador do navegador a partir do ambiente de trabalho TOS. O backend escuta apenas em loopback: nenhuma porta extra é exposta, todo o tráfego passa pela rota padrão do servidor web TOS. Corre com um utilizador dedicado sem privilégios numa sandbox systemd reforçada. Primeiro início de sessão: utilizador «admin»; a palavra-passe inicial é gerada na instalação e guardada em /var/lib/alist/admin_password.txt (legível pela conta de administrador do NAS)."
release_note = "Compilado a partir do código-fonte oficial do AList 3.64.0 (compilação Go estática, zero dependências de runtime, frontend incorporado; trilha de auditoria CI pública). A palavra-passe inicial de administrador é gerada na instalação e guardada em /var/lib/alist/admin_password.txt (legível pela conta de administrador do NAS; utilizador: admin). Base de dados, configuração e índice de pesquisa ficam em /var/lib/alist. Endpoint WebDAV: http://<IP-NAS>:8181/alist/dav/. Portas, base de dados e serviços opcionais FTP/SFTP/S3 ajustam-se em /usr/local/alist/alist.env, reiniciando depois o serviço."
important    = "Nome de utilizador inicial: admin. A palavra-passe inicial de administrador é guardada apenas em /var/lib/alist/admin_password.txt: leia-a logo após a instalação, inicie sessão com «admin» e altere-a na interface web. O 'apt remove' mantém os dados em /var/lib/alist; o 'apt purge' apaga tudo (incluindo o ficheiro da palavra-passe). Licença upstream: AGPL-3.0."
