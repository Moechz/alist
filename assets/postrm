#!/bin/bash
# postrm - 删除/清除后处理（官方模板 + 本应用清理项）
set -e

MAINT_LOG=/var/log/alist-maint.log
mkdir -p /var/log 2>/dev/null || true
echo "$(date '+%F %T') postrm $*" >> "$MAINT_LOG" 2>/dev/null || true

systemctl daemon-reload 2>/dev/null || true

if [ "$1" = "purge" ]; then
  # 数据库、配置、缓存与首装密码文件（remove 时保留，purge 才全清）
  rm -rf /var/lib/alist
  # 系统层注册文件（postinst 兜底安装的）
  rm -f /etc/systemd/system/alist.service
  rm -f /etc/nginx/conf.d/alist.conf
  # 运行用户
  if id -u alist > /dev/null 2>&1; then
    userdel alist 2>/dev/null || true
  fi
  systemctl daemon-reload 2>/dev/null || true
  # nginx 路由移除后重载生效
  if command -v nginx > /dev/null 2>&1 && nginx -t > /dev/null 2>&1; then
    nginx -s reload > /dev/null 2>&1 || true
  fi
  # 注：/var/log/alist-maint.log 保留（purge 取证用）
  # 注：/usr/local/alist 由 dpkg 按包清单删除；但 postinst 派生的文件不在清单里
  # （webui 占位页解压物、首装复制的 env），此处补清以免目录残留/属主悬空
  rm -f /usr/local/alist/index.html /usr/local/alist/alist.env
  rmdir --ignore-fail-on-non-empty /usr/local/alist 2>/dev/null || true
fi

exit 0
