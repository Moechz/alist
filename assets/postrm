#!/bin/bash
# postrm - 删除/清除后处理（官方模板 + 本应用清理项）
#
# 官方 Package Specification 生命周期表要求：dpkg --remove（应用中心卸载）
# 触发 postrm 时就要 "Clean up user, data, residual files"。评审项 F11
# （卸载后残留配置/数据）由上一版只在 purge 清理导致；本版改为
# remove 与 purge 都做完整清理；升级路径（upgrade/failed-upgrade/…）
# 绝不清理数据，否则用户升级即丢库。
set -e
# 应用中心/最小 PATH 环境下也要能解析 systemctl/nginx 等系统工具（F1 同类问题）。
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 027

MAINT_LOG=/var/log/alist-maint.log
mkdir -p /var/log 2>/dev/null || true
{ echo "$(date '+%F %T') postrm $*" >> "$MAINT_LOG"; } 2>/dev/null || true
chmod 0600 "$MAINT_LOG" 2>/dev/null || true   # S11：维护日志仅 root 可读

systemctl daemon-reload 2>/dev/null || true

clean_everything() {
  # 1. 数据库、配置、缓存、搜索索引与首装密码文件
  rm -rf /var/lib/alist
  # 2. 系统层注册文件（postinst 兜底安装的实体副本）
  rm -f /etc/systemd/system/alist.service
  rm -f /etc/nginx/conf.d/alist.conf
  # 3. postinst 派生的文件不在 dpkg 清单里，补清以免目录残留/属主悬空
  rm -f /usr/local/alist/index.html /usr/local/alist/alist.env
  rmdir --ignore-fail-on-non-empty /usr/local/alist 2>/dev/null || true
  # 4. 专用运行用户
  if id -u alist > /dev/null 2>&1; then
    userdel alist 2>/dev/null || true
  fi
  systemctl daemon-reload 2>/dev/null || true
  # 5. nginx 路由移除后重载生效
  if command -v nginx > /dev/null 2>&1 && nginx -t > /dev/null 2>&1; then
    nginx -s reload > /dev/null 2>&1 || true
  fi
}

case "$1" in
  remove|purge)
    clean_everything
    # 维护日志也不留（F11：卸载后零残留）；卸载动作本身系统已记入 dpkg 日志
    rm -f "$MAINT_LOG"
    ;;
  upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    # 升级/回滚：数据必须保留
    ;;
esac

exit 0
