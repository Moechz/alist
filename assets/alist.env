# ============================================================
# AList 用户配置（由 alist.env.example 首装复制而来）
# 修改后执行: systemctl restart alist
#
# 配置优先级: 本文件的环境变量 > /var/lib/alist/config.json > 内置默认值
# （AList 以 ALIST_ 前缀读取环境变量，caarlos0/env 解析）
# 完整配置项: https://alistgo.com/guide/configuration/config.html
#
# 安全说明：以下三个活动默认值与首装预置的 config.json 互为双保险——
# 即使误删本文件或误删 config.json，服务也只会监听回环、不会端口外泄。
# ============================================================

# 监听地址与端口（默认仅回环；TOS nginx 经 /alist/ 路由转发）
ALIST_ADDR=127.0.0.1
ALIST_HTTP_PORT=15244

# 子路径前缀（与 nginx 路由 /alist/ 保持一致，改前缀需同步改 nginx 配置）
ALIST_SITE_URL=/alist

# HTTPS（默认关闭；开启需提供证书路径，一般经由 TOS 8181 访问无需开启）
#ALIST_HTTPS_PORT=-1
#ALIST_FORCE_HTTPS=false
#ALIST_CERT_FILE=/var/lib/alist/cert.pem
#ALIST_KEY_FILE=/var/lib/alist/key.pem

# 数据库（默认 SQLite，文件在 /var/lib/alist/data.db；也可换 MySQL/PostgreSQL）
#ALIST_DB_TYPE=mysql
#ALIST_DB_HOST=127.0.0.1
#ALIST_DB_PORT=3306
#ALIST_DB_USER=alist
#ALIST_DB_PASS=changeme
#ALIST_DB_NAME=alist

# 站点公告/横幅等可在管理后台设置；以下为少量常用服务端项
# 登录令牌有效期（小时）
#ALIST_TOKEN_EXPIRES_IN=48

# 内置 FTP/SFTP/S3/MCP 服务（默认全部关闭；监听地址跟随 ALIST_ADDR，
# 开启后如需外网访问请自行评估安全风险）
#ALIST_S3_ENABLE=false
#ALIST_FTP_ENABLE=false
#ALIST_SFTP_ENABLE=false
#ALIST_MCP_ENABLE=false
